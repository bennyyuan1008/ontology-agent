{
  "_说明": "盲测池：开发过程从未见过的全新问法（口语化/模糊/跨对象/派生分组/边界），用于衡量样本外泛化。跑 run_eval.py --blind 评估。",
  "entries": [
    {
      "id": 1,
      "category": "多对象JOIN",
      "difficulty": "easy",
      "question": "3月哪个店卖得最火？",
      "expected_plan": {
        "object": "Order",
        "aggregate": {
          "func": "SUM",
          "property": "pay_amt"
        },
        "filters": [
          {
            "property": "order_date",
            "op": "between",
            "value": [
              "2026-03-01",
              "2026-03-31"
            ]
          },
          {
            "property": "type",
            "op": "=",
            "value": 0
          }
        ],
        "group_by": [
          {
            "link": "store",
            "property": "store_name"
          }
        ],
        "order_by": {
          "property": "agg_result",
          "dir": "DESC"
        },
        "limit": 1
      },
      "expected_sql": "SELECT SUM(\"Order\".\"PAY_AMT\") AS agg_result, CAST((SELECT L.ORG_NAME FROM POS.DCP_ORG_LANG L WHERE L.ORGANIZATIONNO = \"store\".ORGANIZATIONNO AND L.LANG_TYPE = 'zh_CN' AND ROWNUM = 1) AS VARCHAR2(4000)) FROM \"POS\".\"DCP_SALE\" \"Order\" JOIN \"POS\".\"DCP_ORG\" \"store\" ON \"Order\".\"SHOPID\" = \"store\".\"ORGANIZATIONNO\" WHERE TO_CHAR(TO_DATE(\"Order\".BDATE,'YYYYMMDD'),'YYYY-MM-DD') BETWEEN '2026-03-01' AND '2026-03-31' AND \"Order\".\"TYPE\" = '0' GROUP BY \"store\".\"ORGANIZATIONNO\" ORDER BY agg_result DESC NULLS LAST FETCH FIRST 1 ROWS ONLY",
      "expected_result": [
        {
          "AGG_RESULT": 847043.83,
          "CAST((SELECTL.ORG_NAMEFROMPOS.DCP_ORG_LANGLWHEREL.ORGANIZATIONNO=\"STORE\".ORGANIZATIONNOANDL.LANG_TYPE='ZH_CN'ANDROWNUM=1)ASVARCHAR2(4000))": "直营店1-16"
        }
      ],
      "kind": "query"
    },
